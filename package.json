  "main": "index.html",
  "scripts": {
    "start": "serve -l 3000 .",
    "dev": "serve -l 3000 .",
    "compile": "hardhat compile",
    "deploy:base-sepolia": "hardhat run scripts/deployBase.js --network base-sepolia",
    "deploy:base-mainnet": "hardhat run scripts/deployBase.js --network base-mainnet",
